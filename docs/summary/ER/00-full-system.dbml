// ═══════════════════════════════════════════════════════════════════════════
// Nail Studio 3D — ER Diagram ฉบับสมบูรณ์ (Target Design)
// ───────────────────────────────────────────────────────────────────────────
// สังเคราะห์จากการวิเคราะห์ 2 แหล่ง:
//   (ก) สคีมาที่ใช้งานจริงตอนนี้  — prisma/schema.prisma (25 ตาราง)
//   (ข) ดีไซน์ชุดเดิม             — Olddesine/*.txt (6 โดเมน)
// เหตุผลการตัดสินรายข้ออยู่ใน docs/summary/ER/ANALYSIS.md
//
// 39 ตาราง / 16 enum — PostgreSQL 16 + ส่วนขยาย pgvector
// วิธีใช้: คัดลอกทั้งไฟล์ไปวางที่ https://dbdiagram.io/d
// ═══════════════════════════════════════════════════════════════════════════

Project nail_studio_3d {
  database_type: 'PostgreSQL'
  Note: '''
  ระบบออกแบบเล็บ 3 มิติ + ชุมชนแชร์แม่แบบ + จองร้าน + แชท + ผู้ช่วย AI

  หลักการออกแบบ
  1. แยก "งานส่วนตัว" (projects) ออกจาก "การเผยแพร่" (nail_templates)
  2. เก็บ snapshot งานออกแบบเป็นเวอร์ชันที่เปลี่ยนแปลงไม่ได้ (design_versions)
  3. ค่าที่ต้องกรอง/จัดกลุ่ม ทำเป็นตาราง ไม่ใช่ข้อความอิสระหรือ array
  4. ค่าที่อ่านบ่อยมาก เก็บซ้ำไว้บนแถว (counter) แล้วอัปเดตด้วย trigger
  5. เวลาใช้ timestamptz เสมอ, รหัสใช้ uuid เสมอ
  '''
}

// ═══════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════

Enum user_role {
  user  [note: 'ลูกค้าทั่วไป']
  shop  [note: 'ร้าน/ช่างทำเล็บ — ต้องมีแถวใน shop_profiles']
  admin [note: 'ผู้ดูแลระบบ']
}

Enum project_status {
  draft
  published
  archived
}

Enum palette_harmony {
  analogous
  complementary
  triadic
  monochrome
}

Enum palette_source {
  curated
  extracted
}

Enum template_origin {
  original [note: 'ผู้ใช้ออกแบบเอง']
  ai       [note: 'ผู้ช่วย AI สร้างให้']
  remix    [note: 'ต่อยอดจากแม่แบบอื่น']
}

Enum template_visibility {
  public   [note: 'เห็นในฟีดชุมชน']
  unlisted [note: 'เข้าถึงได้เฉพาะคนมีลิงก์']
  hidden   [note: 'เจ้าของเท่านั้น']
}

Enum share_channel {
  link
  facebook
  line
  instagram
  copy
}

Enum report_target {
  template
  comment
  message
  user
  shop
}

Enum report_reason {
  spam
  inappropriate
  copyright
  harassment
  impersonation
  other
}

Enum report_status {
  pending
  reviewing
  resolved
  dismissed
}

Enum notification_kind {
  post_like
  post_comment
  post_rating
  template_remix
  appointment_status
  appointment_message
  direct_message
  system
}

Enum appointment_status {
  pending        [note: 'ลูกค้าส่งคำขอ รอร้านตอบ']
  counter_offered [note: 'ฝ่ายใดฝ่ายหนึ่งเสนอเวลา/ราคาใหม่']
  confirmed
  declined
  cancelled
  completed
  no_show
  expired        [note: 'เลย expires_at โดยไม่มีใครตอบ']
}

Enum proposal_actor {
  customer
  shop
}

Enum proposal_status {
  pending
  accepted
  rejected
  superseded
}

Enum message_kind {
  text
  image
  system
}

Enum ai_message_role {
  user
  assistant
  system
}

// ═══════════════════════════════════════════════════════════════════════════
// 1 · IDENTITY & AUTH
// ═══════════════════════════════════════════════════════════════════════════

Table users {
  id uuid [pk]
  username varchar(32) [unique, not null, note: 'ชื่อเฉพาะสำหรับ URL โปรไฟล์และการ mention']
  email text [unique, not null]
  password_hash text [not null, note: 'Argon2id — ไม่เก็บรหัสผ่านดิบ']
  role user_role [not null, default: 'user']
  display_name text [not null, note: 'ชื่อที่แสดง เปลี่ยนได้ ไม่ต้องไม่ซ้ำ']
  avatar_asset_id uuid [null, note: 'null = ใช้ gradient สุ่มจาก username']
  bio text [null]
  date_of_birth date [null]
  terms_accepted_at timestamptz [null]
  is_email_verified boolean [not null, default: false]
  is_active boolean [not null, default: true, note: 'false = แอดมินปิดบัญชีถาวร']
  suspended_until timestamptz [null, note: 'ระงับชั่วคราวจากผลการตรวจรายงาน']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    username [unique]
    email [unique]
    (role, is_active)
  }
  Note: 'บัญชีเดียวใช้ได้ทุกบทบาท — ร้านก็จองร้านอื่นได้ เพราะ role คุมแค่สิทธิ์เพิ่มเติม'
}

Table sessions {
  id uuid [pk]
  user_id uuid [not null]
  token_hash bytea [unique, not null, note: 'SHA-256 ของ token — ฐานข้อมูลรั่วก็ปลอม cookie ไม่ได้']
  ip_address inet [null]
  user_agent text [null]
  expires_at timestamptz [not null]
  last_seen_at timestamptz [not null]
  revoked_at timestamptz [null, note: 'ออกจากระบบ/ถูกเพิกถอน — เก็บไว้ตรวจสอบย้อนหลัง']
  created_at timestamptz [not null]

  indexes {
    user_id
    expires_at
  }
}

Table password_resets {
  id uuid [pk]
  user_id uuid [not null]
  token_hash bytea [unique, not null]
  expires_at timestamptz [not null]
  used_at timestamptz [null]
  created_at timestamptz [not null]

  indexes {
    (user_id, created_at)
  }
  Note: 'รับมาจากดีไซน์เดิม — สคีมาปัจจุบันไม่มี ทำให้ "ลืมรหัสผ่าน" ทำไม่ได้เลย'
}

Table login_history {
  id uuid [pk]
  user_id uuid [null, note: 'null เมื่อกรอกอีเมลที่ไม่มีในระบบ']
  email_attempted text [not null]
  is_success boolean [not null]
  ip_address inet [null]
  user_agent text [null]
  created_at timestamptz [not null]

  indexes {
    (user_id, created_at)
    (ip_address, created_at) [note: 'ใช้ตรวจจับการเดารหัสผ่าน']
  }
}

Table user_blocks {
  blocker_id uuid [not null]
  blocked_id uuid [not null]
  created_at timestamptz [not null]

  indexes {
    (blocker_id, blocked_id) [pk]
    blocked_id
  }
  Note: 'บล็อกแล้วส่งข้อความหากันไม่ได้ และไม่เห็นโพสต์ของกันและกัน'
}

// ═══════════════════════════════════════════════════════════════════════════
// 2 · DESIGN WORKSPACE — งานออกแบบส่วนตัว
// ═══════════════════════════════════════════════════════════════════════════

Table projects {
  id uuid [pk]
  user_id uuid [not null]
  name text [not null]
  status project_status [not null, default: 'draft']
  version_count int [not null, default: 0]
  thumbnail_asset_id uuid [null]
  draft_document jsonb [null, note: 'ปลายทางของ autosave ทุก 3 วิ — ยังไม่นับเป็นเวอร์ชัน']
  draft_updated_at timestamptz [null]
  draft_base_version int [null, note: 'draft นี้ต่อยอดจากเวอร์ชันไหน ใช้ตรวจว่าล้าสมัยหรือยัง']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz [null]

  indexes {
    (user_id, updated_at, id) [note: 'partial WHERE deleted_at IS NULL — keyset pagination']
  }
  Note: 'พื้นที่ทำงานส่วนตัว ลบโพสต์ในชุมชนแล้วงานนี้ยังอยู่'
}

Table design_versions {
  id uuid [pk]
  project_id uuid [not null]
  version_number int [not null]
  schema_version int [not null, default: 2, note: 'เวอร์ชันของโครงสร้าง document ใช้ตอน migrate']
  document jsonb [not null, note: 'ทั้งชั้นสี ลาย อัญมณี พิกัด 3 มิติ — schemaless โดยตั้งใจ']
  label text [null]
  created_at timestamptz [not null]

  indexes {
    (project_id, version_number) [unique, note: 'รากฐานของ optimistic concurrency']
  }
  Note: 'snapshot ที่ผู้ใช้ตั้งใจกดบันทึก — เปลี่ยนแปลงไม่ได้ตลอดกาล'
}

Table assets {
  id uuid [pk]
  owner_id uuid [null, note: 'null = ไฟล์ระบบ ไม่มีเจ้าของ']
  kind text [not null, note: 'thumbnail | reference | avatar | attachment | evidence']
  storage_key text [unique, not null, note: 'ที่อยู่ใน object storage — ย้าย CDN ไม่ต้องแก้ทุกแถว']
  mime_type text [not null]
  size_bytes bigint [not null]
  width int [null, note: 'ยกจาก metadata ขึ้นมาเป็นคอลัมน์ เพราะต้องตรวจขนาดตอนอัปโหลดทุกครั้ง']
  height int [null]
  checksum_sha256 bytea [not null, note: 'ไฟล์เดิมอัปซ้ำ ใช้แถวเดิมได้']
  metadata jsonb [not null, note: 'EXIF และค่าเฉพาะประเภทไฟล์']
  created_at timestamptz [not null]

  indexes {
    (owner_id, kind, created_at)
    checksum_sha256
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// 3 · DESIGN CATALOG — ข้อมูลตั้งต้นของเครื่องมือออกแบบ (seed)
// ═══════════════════════════════════════════════════════════════════════════

Table brand_colors {
  id uuid [pk]
  brand text [not null]
  name text [not null]
  hex varchar(7) [not null]
  is_available boolean [not null, default: true]

  indexes {
    (brand, hex) [unique]
    (brand, is_available)
  }
  Note: 'สีจริงจากยี่ห้อยาทาเล็บ ใช้เทียบว่าสีที่ออกแบบซื้อได้จริงไหม'
}

Table color_palettes {
  id uuid [pk]
  code text [unique, not null]
  name_th text [not null]
  colors jsonb [not null, note: 'ชุดสี 3–5 สีพร้อมสัดส่วน']
  harmony palette_harmony [not null]
  source palette_source [not null, default: 'curated']
  popularity int [not null, default: 0]
  is_active boolean [not null, default: true]

  indexes {
    (is_active, popularity)
  }
}

Table design_archetypes {
  id uuid [pk]
  code text [unique, not null]
  name_th text [not null]
  composer_key text [not null, note: 'ชื่อฟังก์ชันฝั่งหน้าเว็บที่ประกอบลายนี้']
  default_params jsonb [not null]
  supported_zones "text[]" [not null, note: 'ค่าคงที่ของระบบ ไม่ใช่ข้อมูลผู้ใช้ จึงยอมให้เป็น array ได้']
  popularity int [not null, default: 0]
  is_active boolean [not null, default: true]

  indexes {
    (is_active, popularity)
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// 4 · COMMUNITY — แม่แบบและปฏิสัมพันธ์
// ═══════════════════════════════════════════════════════════════════════════

Table nail_templates {
  id uuid [pk]
  author_id uuid [not null]
  design_version_id uuid [not null, note: 'ไม่เก็บชั้นลายเอง — ชี้ไปที่ snapshot ที่ตายตัวแล้ว']
  name text [not null]
  caption text [null]
  primary_color varchar(7) [null, note: 'สีเด่น ใช้ทำ color filter ในฟีด']
  difficulty smallint [null, note: '1–5 รับมาจากดีไซน์เดิม']
  origin template_origin [not null, default: 'original']
  source_template_id uuid [null, note: 'อ้างตัวเอง — remix มาจากแม่แบบไหน']
  thumbnail_asset_id uuid [null]
  visibility template_visibility [not null, default: 'public']
  like_count int [not null, default: 0]
  comment_count int [not null, default: 0]
  remix_count int [not null, default: 0]
  share_count int [not null, default: 0]
  view_count int [not null, default: 0]
  report_count int [not null, default: 0]
  rating_avg decimal(3,2) [not null, default: 0]
  rating_count int [not null, default: 0]
  recipe jsonb [null, note: 'ขั้นตอนทำจริง สำหรับช่างอ่านตาม']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz [null]

  indexes {
    (author_id, created_at)
    source_template_id
    (visibility, created_at) [note: 'ฟีดล่าสุด']
    (visibility, like_count) [note: 'ฟีดยอดนิยม']
  }
  Note: 'โพสต์สาธารณะ — 1 งานออกแบบเผยแพร่ได้หลายโพสต์ ลบโพสต์ไม่กระทบงานต้นฉบับ'
}

Table template_categories {
  id uuid [pk]
  code text [unique, not null, note: 'french, minimal, ombre, glitter, nail_art …']
  name_th text [not null]
  sort_order int [not null, default: 0]
  is_active boolean [not null, default: true]

  Note: 'แทน nail_templates.category ที่เดิมเป็นข้อความอิสระ — พิมพ์ผิดกลายเป็นหมวดใหม่'
}

Table template_category_map {
  template_id uuid [not null]
  category_id uuid [not null]

  indexes {
    (template_id, category_id) [pk]
    category_id [note: 'ไล่จากหมวดกลับมาหาแม่แบบ']
  }
  Note: 'N:M — 1 แม่แบบอยู่ได้หลายหมวด (เดิมเลือกได้หมวดเดียว)'
}

Table template_tags {
  id uuid [pk]
  name text [unique, not null]
  usage_count int [not null, default: 0]
  is_blocked boolean [not null, default: false, note: 'แอดมินปิดแท็กที่ไม่เหมาะสม']

  indexes {
    usage_count
  }
}

Table template_tag_map {
  template_id uuid [not null]
  tag_id uuid [not null]
  score real [not null, default: 1, note: 'ผู้ใช้ติดเอง = 1, AI เดาให้ = 0–1 ตามความมั่นใจ']
  created_at timestamptz [not null]

  indexes {
    (template_id, tag_id) [pk]
    (tag_id, score) [note: 'ค้นด้วยแท็ก เรียงตามความเกี่ยวข้อง']
  }
}

Table template_likes {
  template_id uuid [not null]
  user_id uuid [not null]
  created_at timestamptz [not null]

  indexes {
    (template_id, user_id) [pk]
    (user_id, created_at)
  }
  Note: 'ถูกใจ = สัญญาณเบา กดได้ทันที ไม่ต้องคิด'
}

Table template_ratings {
  template_id uuid [not null]
  user_id uuid [not null]
  score smallint [not null, note: '1–5 ดาว']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (template_id, user_id) [pk, note: '1 คนให้คะแนนได้ครั้งเดียว แก้ได้']
    (template_id, score)
  }
  Note: 'ให้ดาว = สัญญาณคุณภาพ แยกจากถูกใจ และแยกจากคอมเมนต์ (ให้ดาวโดยไม่พิมพ์ก็ได้)'
}

Table template_comments {
  id uuid [pk]
  template_id uuid [not null]
  user_id uuid [not null]
  parent_comment_id uuid [null, note: 'ตอบกลับคอมเมนต์ — อ้างตัวเอง 1 ชั้น']
  content text [not null]
  image_asset_id uuid [null, note: 'แนบรูปเล็บที่ทำตามจริง — รับมาจากดีไซน์เดิม']
  is_hidden boolean [not null, default: false, note: 'แอดมินซ่อนจากผลการตรวจรายงาน']
  edited_at timestamptz [null]
  created_at timestamptz [not null]
  deleted_at timestamptz [null]

  indexes {
    (template_id, created_at)
    parent_comment_id
    (user_id, created_at)
  }
}

Table template_share_links {
  id uuid [pk]
  template_id uuid [not null]
  created_by uuid [not null]
  share_code varchar(16) [unique, not null, note: 'รหัสสั้นในลิงก์ /s/{share_code}']
  allow_copy boolean [not null, default: true, note: 'ให้คนกดลอกไปเป็นโปรเจกต์ตัวเองได้ไหม']
  expires_at timestamptz [null, note: 'null = ไม่หมดอายุ']
  revoked_at timestamptz [null]
  view_count int [not null, default: 0]
  copy_count int [not null, default: 0]
  created_at timestamptz [not null]

  indexes {
    share_code [unique]
    (template_id, created_at)
  }
  Note: 'ลิงก์แชร์ของจริง — คนไม่มีบัญชีเปิดดูได้ รับมาจากดีไซน์เดิมทั้งก้อน'
}

Table template_share_events {
  id uuid [pk]
  template_id uuid [not null]
  user_id uuid [null, note: 'null = ผู้เยี่ยมชมที่ไม่ได้ล็อกอิน']
  share_link_id uuid [null, note: 'แชร์ผ่านลิงก์ไหน']
  channel share_channel [not null]
  created_at timestamptz [not null]

  indexes {
    (template_id, created_at)
    (user_id, created_at)
  }
  Note: 'บันทึกพฤติกรรม "กดปุ่มแชร์" สำหรับสถิติ — คนละเรื่องกับ template_share_links'
}

Table template_remixes {
  id uuid [pk]
  template_id uuid [not null]
  user_id uuid [not null]
  project_id uuid [not null, note: 'remix แล้วได้โปรเจกต์ส่วนตัว ไม่ใช่โพสต์ใหม่ทันที']
  created_at timestamptz [not null]

  indexes {
    (template_id, project_id) [unique]
    (user_id, created_at)
  }
  Note: 'ถ้าผู้ใช้เผยแพร่ผลลัพธ์ทีหลัง โพสต์ใหม่จะตั้ง source_template_id เป็นต้นฉบับ'
}

// ═══════════════════════════════════════════════════════════════════════════
// 5 · MODERATION & NOTIFICATION
// ═══════════════════════════════════════════════════════════════════════════

Table content_reports {
  id uuid [pk]
  target_type report_target [not null]
  target_id uuid [not null, note: 'polymorphic โดยตั้งใจ — ไม่มี FK ตัวเดียวชี้ได้ 5 ตาราง']
  reporter_id uuid [not null]
  reason report_reason [not null]
  detail text [null]
  evidence_asset_id uuid [null, note: 'ภาพหลักฐาน — รับมาจากดีไซน์เดิม']
  status report_status [not null, default: 'pending']
  reviewed_by uuid [null, note: 'แอดมินที่ตรวจ']
  reviewed_at timestamptz [null]
  resolution_note text [null]
  created_at timestamptz [not null]

  indexes {
    (target_type, target_id, reporter_id) [unique, note: 'คนเดิมรายงานเป้าเดิมซ้ำไม่ได้']
    (status, created_at) [note: 'คิวงานแอดมิน']
    (target_type, target_id) [note: 'นับว่าถูกรายงานกี่ครั้ง']
  }
}

Table notifications {
  id uuid [pk]
  user_id uuid [not null]
  kind notification_kind [not null]
  title text [not null]
  body text [null, note: 'รับมาจากดีไซน์เดิม — ของปัจจุบันมีแต่หัวข้อ']
  data_json jsonb [null, note: 'payload สำหรับ deep link ในแอป']
  source_type text [not null]
  source_id uuid [not null]
  is_read boolean [not null, default: false]
  read_at timestamptz [null]
  created_at timestamptz [not null]

  indexes {
    (user_id, created_at)
    (user_id, is_read) [note: 'นับป้ายแดง']
  }
}

Table user_notification_settings {
  user_id uuid [pk]
  allow_social boolean [not null, default: true, note: 'ถูกใจ/คอมเมนต์/ให้ดาว/remix']
  allow_appointment boolean [not null, default: true]
  allow_direct_message boolean [not null, default: true]
  allow_system boolean [not null, default: true]
  email_enabled boolean [not null, default: false]
  updated_at timestamptz [not null]

  Note: 'รับมาจากดีไซน์เดิม — ปัจจุบันปิดการแจ้งเตือนไม่ได้เลย'
}

// ═══════════════════════════════════════════════════════════════════════════
// 6 · SHOP & BOOKING
// ═══════════════════════════════════════════════════════════════════════════

Table shop_profiles {
  user_id uuid [pk, note: '1:1 กับ users — ใช้ PK เดียวกันเป็น FK ไม่ต้องมี id ซ้ำซ้อน']
  shop_name text [not null]
  description text [null]
  location_text text [null]
  latitude decimal(9,6) [null, note: 'ค้นหาร้านใกล้ฉัน']
  longitude decimal(9,6) [null]
  is_verified boolean [not null, default: false]
  rating_avg decimal(3,2) [not null, default: 0]
  rating_count int [not null, default: 0]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (is_verified, rating_avg, rating_count)
    (latitude, longitude)
  }
}

Table shop_phones {
  id uuid [pk]
  shop_id uuid [not null]
  phone_number varchar(20) [not null]
  label text [null, note: 'สาขา / มือถือ / LINE']
  sort_order int [not null, default: 0]

  indexes {
    (shop_id, sort_order)
    phone_number
  }
  Note: 'แยกออกจาก array phone_numbers[] เดิม เพื่อให้อยู่ในรูปแบบ 1NF และค้นด้วยเบอร์ได้'
}

Table shop_opening_hours {
  id uuid [pk]
  shop_id uuid [not null]
  day_of_week smallint [not null, note: '0=อาทิตย์ … 6=เสาร์']
  open_time time [not null]
  close_time time [not null]
  is_active boolean [not null, default: true]

  indexes {
    (shop_id, day_of_week)
  }
  Note: 'แทน opening_hours jsonb — ทำให้ถามว่า "ร้านไหนเปิดวันอาทิตย์บ่าย" ด้วย SQL ได้'
}

Table shop_time_off {
  id uuid [pk]
  shop_id uuid [not null]
  start_at timestamptz [not null]
  end_at timestamptz [not null]
  reason text [null]

  indexes {
    (shop_id, start_at)
  }
  Note: 'วันหยุด/ลาพัก — รับมาจาก provider_time_off ในดีไซน์เดิม ใช้กันไม่ให้จองทับ'
}

Table shop_services {
  id uuid [pk]
  shop_id uuid [not null]
  name text [not null]
  description text [null]
  price_thb decimal(10,2) [not null]
  duration_minutes int [not null]
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]

  indexes {
    (shop_id, sort_order)
  }
}

Table appointments {
  id uuid [pk]
  customer_id uuid [not null]
  shop_id uuid [not null]
  service_id uuid [null, note: 'null = นัดคุยก่อน ยังไม่เลือกบริการ']
  design_version_id uuid [null, note: 'แนบแบบที่ออกแบบในระบบ']
  reference_asset_id uuid [null, note: 'หรือแนบรูปจากที่อื่น — รับมาจาก image_url เดิม']
  status appointment_status [not null, default: 'pending']
  agreed_start_at timestamptz [null, note: 'ว่างจนกว่าทั้งสองฝ่ายตกลง — เวลาที่เสนออยู่ใน proposals']
  duration_minutes int [not null]
  price_quoted_thb decimal(10,2) [null]
  expires_at timestamptz [null, note: 'คำขอหมดอายุถ้าร้านไม่ตอบ — รับมาจากดีไซน์เดิม']
  customer_note text [null]
  shop_note text [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (customer_id, created_at)
    (shop_id, status, created_at)
    (shop_id, agreed_start_at) [note: 'ปฏิทินของร้าน + ตรวจเวลาทับซ้อน']
  }
  Note: 'หนึ่งแถวตลอดวงจร ไม่แยก request/appointment เป็นสองตาราง — ไม่ต้องคัดลอกข้อมูลซ้ำ'
}

Table appointment_proposals {
  id uuid [pk]
  appointment_id uuid [not null]
  proposed_by proposal_actor [not null]
  proposed_start_at timestamptz [not null]
  duration_minutes int [not null]
  price_thb decimal(10,2) [null]
  message text [null]
  status proposal_status [not null, default: 'pending']
  created_at timestamptz [not null]

  indexes {
    (appointment_id, created_at)
  }
  Note: 'ประวัติการต่อรองครบทุกรอบ — ใครเสนอ เวลาไหน ราคาเท่าไร ผลเป็นอย่างไร'
}

Table shop_reviews {
  id uuid [pk]
  appointment_id uuid [unique, not null, note: 'รีวิวได้ก็ต่อเมื่อเคยจองจริง — กันรีวิวปลอม']
  shop_id uuid [not null]
  author_id uuid [not null]
  rating smallint [not null, note: '1–5']
  comment text [null]
  image_asset_id uuid [null, note: 'รูปผลงานที่ได้จริง']
  shop_reply text [null]
  shop_replied_at timestamptz [null]
  is_hidden boolean [not null, default: false]
  created_at timestamptz [not null]
  deleted_at timestamptz [null]

  indexes {
    (shop_id, created_at)
    (author_id, created_at)
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// 7 · MESSAGING — แชท 1:1 ระหว่างลูกค้ากับร้าน
// ═══════════════════════════════════════════════════════════════════════════

Table conversations {
  id uuid [pk]
  participant_a_id uuid [not null, note: 'บังคับให้ a < b เสมอตอนสร้าง']
  participant_b_id uuid [not null]
  created_by_id uuid [not null]
  appointment_id uuid [null, note: 'ห้องที่เกิดจากการจอง']
  last_message_at timestamptz [not null]
  created_at timestamptz [not null]

  indexes {
    (participant_a_id, participant_b_id) [unique, note: 'กันห้องซ้ำระหว่างคนคู่เดิม']
    (participant_a_id, last_message_at)
    (participant_b_id, last_message_at)
  }
  Note: 'จงใจทำแค่ 1:1 — เก็บคู่สนทนาไว้บนแถวจึงบังคับ unique กันห้องซ้ำได้ ซึ่งตาราง members ทำไม่ได้'
}

Table conversation_messages {
  id uuid [pk]
  conversation_id uuid [not null]
  sender_id uuid [null, note: 'null เมื่อผู้ส่งลบบัญชี — ข้อความยังอยู่ให้อีกฝ่ายอ่าน']
  kind message_kind [not null, default: 'text']
  content text [not null]
  read_at timestamptz [null, note: 'ห้อง 1:1 มีผู้รับคนเดียว จึงไม่ต้องมีตาราง message_reads']
  edited_at timestamptz [null]
  created_at timestamptz [not null]
  deleted_at timestamptz [null]

  indexes {
    (conversation_id, created_at, id) [note: 'keyset pagination ย้อนประวัติ']
    (conversation_id, read_at) [note: 'นับข้อความที่ยังไม่อ่าน']
  }
}

Table message_attachments {
  id uuid [pk]
  message_id uuid [not null]
  asset_id uuid [not null, note: 'ชี้ไป assets ไม่เก็บ file_url ซ้ำเหมือนดีไซน์เดิม']
  sort_order int [not null, default: 0]

  indexes {
    message_id
  }
  Note: 'รับมาจากดีไซน์เดิม — ส่งรูปแบบเล็บให้ร้านดูคือฟีเจอร์ที่ขาดไม่ได้'
}

// ═══════════════════════════════════════════════════════════════════════════
// 8 · AI ASSISTANT
// ═══════════════════════════════════════════════════════════════════════════

Table ai_chat_sessions {
  id uuid [pk]
  user_id uuid [not null]
  title text [null, note: 'สรุปจากข้อความแรก']
  model_name text [not null, note: 'llama3.1:8b …']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (user_id, updated_at)
  }
  Note: 'แก้จุดบกพร่องของสคีมาปัจจุบันที่ ai_chat_messages.session_id ไม่ได้ชี้ไปไหนเลย'
}

Table ai_chat_messages {
  id uuid [pk]
  session_id uuid [not null]
  role ai_message_role [not null]
  content text [not null]
  token_count int [null]
  created_at timestamptz [not null]

  indexes {
    (session_id, created_at)
  }
}

Table knowledge_entries {
  id uuid [pk]
  question text [not null]
  answer text [not null]
  embedding "vector(768)" [null, note: 'pgvector — ค้นด้วยความหมาย ไม่ใช่แค่คำตรงตัว']
  source_type text [null, note: 'template | faq | manual']
  source_id uuid [null]
  created_by uuid [null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]

  indexes {
    (is_active, created_at)
    embedding [note: 'ดัชนี HNSW ของ pgvector — เพื่อนบ้านใกล้สุดโดยประมาณ']
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// RELATIONSHIPS
// ═══════════════════════════════════════════════════════════════════════════

// -- Identity -------------------------------------------------------------
Ref: users.avatar_asset_id > assets.id [delete: set null]
Ref: sessions.user_id > users.id [delete: cascade]
Ref: password_resets.user_id > users.id [delete: cascade]
Ref: login_history.user_id > users.id [delete: set null]
Ref: user_blocks.blocker_id > users.id [delete: cascade]
Ref: user_blocks.blocked_id > users.id [delete: cascade]

// -- Workspace ------------------------------------------------------------
Ref: projects.user_id > users.id [delete: cascade]
Ref: projects.thumbnail_asset_id > assets.id [delete: set null]
Ref: design_versions.project_id > projects.id [delete: cascade]
Ref: assets.owner_id > users.id [delete: cascade]

// -- Community ------------------------------------------------------------
Ref: nail_templates.author_id > users.id [delete: cascade]
Ref: nail_templates.design_version_id > design_versions.id [delete: restrict]
Ref: nail_templates.source_template_id > nail_templates.id [delete: set null]
Ref: nail_templates.thumbnail_asset_id > assets.id [delete: set null]

Ref: template_category_map.template_id > nail_templates.id [delete: cascade]
Ref: template_category_map.category_id > template_categories.id [delete: cascade]
Ref: template_tag_map.template_id > nail_templates.id [delete: cascade]
Ref: template_tag_map.tag_id > template_tags.id [delete: cascade]

Ref: template_likes.template_id > nail_templates.id [delete: cascade]
Ref: template_likes.user_id > users.id [delete: cascade]
Ref: template_ratings.template_id > nail_templates.id [delete: cascade]
Ref: template_ratings.user_id > users.id [delete: cascade]

Ref: template_comments.template_id > nail_templates.id [delete: cascade]
Ref: template_comments.user_id > users.id [delete: cascade]
Ref: template_comments.parent_comment_id > template_comments.id [delete: cascade]
Ref: template_comments.image_asset_id > assets.id [delete: set null]

Ref: template_share_links.template_id > nail_templates.id [delete: cascade]
Ref: template_share_links.created_by > users.id [delete: cascade]
Ref: template_share_events.template_id > nail_templates.id [delete: cascade]
Ref: template_share_events.user_id > users.id [delete: set null]
Ref: template_share_events.share_link_id > template_share_links.id [delete: set null]

Ref: template_remixes.template_id > nail_templates.id [delete: cascade]
Ref: template_remixes.user_id > users.id [delete: cascade]
Ref: template_remixes.project_id > projects.id [delete: cascade]

// -- Moderation & Notification -------------------------------------------
Ref: content_reports.reporter_id > users.id [delete: cascade]
Ref: content_reports.reviewed_by > users.id [delete: set null]
Ref: content_reports.evidence_asset_id > assets.id [delete: set null]
Ref: notifications.user_id > users.id [delete: cascade]
Ref: user_notification_settings.user_id - users.id [delete: cascade]

// -- Shop & Booking -------------------------------------------------------
Ref: shop_profiles.user_id - users.id [delete: cascade]
Ref: shop_phones.shop_id > shop_profiles.user_id [delete: cascade]
Ref: shop_opening_hours.shop_id > shop_profiles.user_id [delete: cascade]
Ref: shop_time_off.shop_id > shop_profiles.user_id [delete: cascade]
Ref: shop_services.shop_id > shop_profiles.user_id [delete: cascade]

Ref: appointments.customer_id > users.id [delete: cascade]
Ref: appointments.shop_id > shop_profiles.user_id [delete: cascade]
Ref: appointments.service_id > shop_services.id [delete: set null]
Ref: appointments.design_version_id > design_versions.id [delete: set null]
Ref: appointments.reference_asset_id > assets.id [delete: set null]
Ref: appointment_proposals.appointment_id > appointments.id [delete: cascade]

Ref: shop_reviews.appointment_id - appointments.id [delete: cascade]
Ref: shop_reviews.shop_id > shop_profiles.user_id [delete: cascade]
Ref: shop_reviews.author_id > users.id [delete: cascade]
Ref: shop_reviews.image_asset_id > assets.id [delete: set null]

// -- Messaging ------------------------------------------------------------
Ref: conversations.participant_a_id > users.id [delete: cascade]
Ref: conversations.participant_b_id > users.id [delete: cascade]
Ref: conversations.created_by_id > users.id [delete: cascade]
Ref: conversations.appointment_id > appointments.id [delete: set null]
Ref: conversation_messages.conversation_id > conversations.id [delete: cascade]
Ref: conversation_messages.sender_id > users.id [delete: set null]
Ref: message_attachments.message_id > conversation_messages.id [delete: cascade]
Ref: message_attachments.asset_id > assets.id [delete: cascade]

// -- AI -------------------------------------------------------------------
Ref: ai_chat_sessions.user_id > users.id [delete: cascade]
Ref: ai_chat_messages.session_id > ai_chat_sessions.id [delete: cascade]
Ref: knowledge_entries.created_by > users.id [delete: set null]

// ═══════════════════════════════════════════════════════════════════════════
// TABLE GROUPS
// ═══════════════════════════════════════════════════════════════════════════

TableGroup "1 · Identity & Auth" {
  users
  sessions
  password_resets
  login_history
  user_blocks
}

TableGroup "2 · Design Workspace" {
  projects
  design_versions
  assets
}

TableGroup "3 · Design Catalog" {
  brand_colors
  color_palettes
  design_archetypes
}

TableGroup "4 · Community" {
  nail_templates
  template_categories
  template_category_map
  template_tags
  template_tag_map
  template_likes
  template_ratings
  template_comments
  template_share_links
  template_share_events
  template_remixes
}

TableGroup "5 · Moderation & Notification" {
  content_reports
  notifications
  user_notification_settings
}

TableGroup "6 · Shop & Booking" {
  shop_profiles
  shop_phones
  shop_opening_hours
  shop_time_off
  shop_services
  appointments
  appointment_proposals
  shop_reviews
}

TableGroup "7 · Messaging" {
  conversations
  conversation_messages
  message_attachments
}

TableGroup "8 · AI Assistant" {
  ai_chat_sessions
  ai_chat_messages
  knowledge_entries
}
