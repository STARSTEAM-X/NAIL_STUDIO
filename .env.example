# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง — ห้าม commit .env
#
# วิธีเตรียมฐานข้อมูล (รันครั้งเดียว ด้วยบัญชี postgres ของคุณเอง):
#
#   & "C:\Program Files\PostgreSQL\18\bin\psql.exe" -U postgres -c "CREATE ROLE nailstudio LOGIN PASSWORD 'รหัสผ่านที่คุณตั้งเอง';"
#   & "C:\Program Files\PostgreSQL\18\bin\psql.exe" -U postgres -c "CREATE DATABASE nailstudio OWNER nailstudio;"
#
# แล้วนำรหัสผ่านที่ตั้งไว้มาใส่ใน DATABASE_URL ด้านล่าง

# ---------- ฐานข้อมูล ----------
DATABASE_URL="postgresql://nailstudio:PASSWORD_HERE@localhost:5432/nailstudio?schema=public"

# ---------- API ----------
NODE_ENV=development
API_PORT=4000

# ที่มาของเว็บที่อนุญาตให้เรียก API (allowlist ไม่ใช่ *)
WEB_ORIGIN=http://localhost:5173

# กุญแจเซ็น session cookie — สร้างใหม่ด้วย:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_32_BYTES_BASE64URL

# อายุ session (วัน)
SESSION_TTL_DAYS=30

# connection ตรงไม่ผ่าน pooler — ใช้กับ LISTEN/NOTIFY และ prisma migrate (Neon ตั้งให้เอง)
# ว่างไว้ได้บนเครื่อง (จะใช้ DATABASE_URL แทน)
# DATABASE_URL_UNPOOLED=
# จำนวน connection สูงสุดต่อ instance — บน Vercel ตั้ง 3
# DB_POOL_MAX=10

# ---------- Storage ----------
# ที่เก็บไฟล์ (thumbnail ฯลฯ): local = ดิสก์ในเครื่อง, vercel-blob = Vercel Blob (private)
# บน Vercel ต้องเป็น vercel-blob เพราะดิสก์ของ function ไม่ถาวร
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
# ต้องตั้งเมื่อ STORAGE_DRIVER=vercel-blob (Vercel ใส่ให้เมื่อเชื่อม Blob store กับ project)
# BLOB_READ_WRITE_TOKEN=

# ---------- Web ----------
VITE_API_URL=http://localhost:4000

# ---------- Optional AI service ----------
# The Express API and apps/ai must share this value; never commit a real token.
AI_INTERNAL_TOKEN=CHANGE_ME_INTERNAL_AI_TOKEN
AI_SERVICE_URL=http://localhost:4100
AI_ENABLE_OLLAMA=false
AI_DATABASE_URL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=scb10x/llama3.1-typhoon2-8b-instruct

# ให้ API ส่งหน้าเว็บ (Vite build) เองจากโดเมนเดียวกัน — ใช้ตอน deploy เป็น service เดียว
# เช่นบน Render: build เว็บด้วย VITE_API_URL=<URL ของ service นี้> แล้วตั้ง WEB_DIST=apps/web/dist
# WEB_DIST=apps/web/dist
