# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง — ห้าม commit .env
#
# วิธีเตรียมฐานข้อมูล (รันครั้งเดียว ด้วยบัญชี postgres ของคุณเอง):
#
#   & "C:\Program Files\PostgreSQL\18\bin\psql.exe" -U postgres -c "CREATE ROLE nailstudio LOGIN PASSWORD 'รหัสผ่านที่คุณตั้งเอง';"
#   & "C:\Program Files\PostgreSQL\18\bin\psql.exe" -U postgres -c "CREATE DATABASE nailstudio OWNER nailstudio;"
#
# แล้วนำรหัสผ่านที่ตั้งไว้มาใส่ใน DATABASE_URL ด้านล่าง

# ---------- ฐานข้อมูล ----------
DATABASE_URL="postgresql://nailstudio:PASSWORD_HERE@localhost:5432/nailstudio?schema=public"

# ---------- API ----------
NODE_ENV=development
API_PORT=4000

# ที่มาของเว็บที่อนุญาตให้เรียก API (allowlist ไม่ใช่ *)
WEB_ORIGIN=http://localhost:5173

# กุญแจเซ็น session cookie — สร้างใหม่ด้วย:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_32_BYTES_BASE64URL

# อายุ session (วัน)
SESSION_TTL_DAYS=30

# ---------- Web ----------
VITE_API_URL=http://localhost:4000
